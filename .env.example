# SEO Ops System — environment variable template
# Copy this file to `.env` (which is gitignored) and fill in real values.
# All keys may be left empty; the system runs in "no AI" mode without them.

# ── Web server ────────────────────────────────────────────────
SEO_OPS_HOST=127.0.0.1
SEO_OPS_PORT=8787
SEO_OPS_TIMEZONE=Asia/Shanghai

# Override the default data directory (default: <repo>/data/)
# SEO_OPS_DATA_DIR=/home/laoma/seo-ops-system/data

# ── AI provider (optional; required for AI features) ─────────
# Compatible with any OpenAI-shaped endpoint (DeepSeek, OpenAI, Azure, etc.)
SEO_OPS_AI_PROVIDER=openai-compatible
SEO_OPS_AI_BASE_URL=
SEO_OPS_AI_MODEL=
SEO_OPS_AI_API_KEY=

# ── External sources (optional; required for SERP, scraping, discovery) ──
# SerpAPI — SERP verification + Google Trends
SEO_OPS_SERPAPI_KEY=
SEO_OPS_SERPAPI_BASE_URL=https://serpapi.com
SEO_OPS_SERPAPI_COUNTRY=us
SEO_OPS_SERPAPI_LANGUAGE=en
SEO_OPS_SERPAPI_LOCATION=United States
SEO_OPS_SERPAPI_DEVICE=desktop

# Google Trends (delivered via SerpAPI)
SEO_OPS_TRENDS_PROVIDER=serpapi
SEO_OPS_TRENDS_GEO=US
SEO_OPS_TRENDS_TIMEFRAME=today 12-m

# Firecrawl — page scraping
SEO_OPS_FIRECRAWL_API_KEY=
SEO_OPS_FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2

# Tavily — discovery / source verification
SEO_OPS_TAVILY_API_KEY=
SEO_OPS_TAVILY_BASE_URL=https://api.tavily.com

# ── Research budget caps (per round) ──────────────────────────
SEO_OPS_RESEARCH_AI_BUDGET=17
SEO_OPS_RESEARCH_FIRECRAWL_BUDGET=7
SEO_OPS_RESEARCH_SERPAPI_BUDGET=5
SEO_OPS_RESEARCH_TAVILY_BUDGET=17

# ── Content production budget (per article) ──────────────────
SEO_OPS_CONTENT_AI_CALL_LIMIT=10

# ── Google Search Console OAuth ───────────────────────────────
# Path to the GSC client secret JSON (downloaded from Google Cloud Console).
# File must exist and be readable by the SEO Ops process.
SEO_OPS_GSC_OAUTH_CLIENT_FILE=.secrets/google/gsc-client-secret.json
# Path to the cached OAuth token (created on first successful auth).
SEO_OPS_GSC_OAUTH_TOKEN_FILE=.secrets/google/gsc-token.json
# OAuth redirect URI; must match the URI configured in Google Cloud Console.
SEO_OPS_GSC_REDIRECT_URI=http://127.0.0.1:8787
# Trusted start date — SEO Ops will only request GSC data on/after this date.
# Operator must set this explicitly after reviewing the first sync.
SEO_OPS_GSC_TRUSTED_START_DATE=