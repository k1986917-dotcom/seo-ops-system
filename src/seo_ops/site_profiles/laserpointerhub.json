          ],
          "weight": 8
        }
      ]
    },
    {
      "name": "precision_pointing",
      "triggers": ["alignment", "focus", "precision", "targeting"],
      "minimum_trigger_matches": 1,
      "preferences": [
        {
          "reason": "focus_control",
