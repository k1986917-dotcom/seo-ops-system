{
  "site_slug": "laserpointerhub",
  "version": 1,
  "product_candidate_limit": 5,
  "product_link_limit_per_section": 1,
  "unique_product_per_article": true,
  "required_fit_levels": [
    "strong",
    "approved_constraint",
    "contextual"
  ],
  "generic_product_terms": [
    "laser",
    "lasers",
    "pointer",
    "pointers",
    "product",
    "products",
    "tool",
    "tools"
  ],
  "prohibited_product_section_patterns": [
    "\\b(?:safety|compliance|legal|regulation|regulatory|hazard|danger|injury|warning)\\b",
    "\\bclass\\s*(?:3r|3b|4)\\b"
  ],
  "high_power_policy": "neutral_for_ranking_and_never_an_exclusion",
  "product_copy_instruction": "Use only catalog-supported product attributes. Do not claim that a product is safe, compliant, approved, certified, or specifically designed for the article use case unless the catalog explicitly supports that exact claim. A catalog-supported power specification may be stated neutrally; never present higher power as automatically safer or universally better.",
  "product_copy_suppressed_patterns": [
    "\\b(?:safe|safer|safest|compliant|compliance|approved|certified|certification)\\b"
  ],
  "product_power_copy_policy": "require_safety_notice_when_high_power_is_mentioned",
  "product_power_copy_instruction": "When a PRODUCT-linked paragraph states a power above 5mW, uses high-power wording, or names Class 3R, Class 3A, Class 3B, or Class 4, add a concise safety reminder in the same paragraph. Tell the reader to use laser protective eyewear matched to the laser wavelength with optical density adequate for the output, avoid direct eye exposure and reflective surfaces, and never aim at vehicles or aircraft. Do not imply that eyewear makes the laser safe, and do not weaken or contradict any hazard discussion elsewhere in the article.",
  "high_power_notice_threshold_mw": 5,
  "variant_label_pattern": "\\b(?:B|G)\\d{3}(?:\\.\\d+)?[A-Z]\\b",
  "use_case_rules": [
    {
      "name": "long_distance_visible_pointing",
      "triggers": [
        "above",
        "bright",
        "ceiling",
        "distance",
        "long range",
        "overhead",
        "pointing",
        "visibility"
      ],
      "minimum_trigger_matches": 2,
      "preferences": [
        {
          "reason": "green_wavelength",
          "terms": ["520nm", "532nm"],
          "weight": 36
        },
        {
          "reason": "green_color",
          "terms": ["green", "emerald"],
          "weight": 24
        },
        {
          "reason": "visible_beam",
          "terms": [
            "highly visible",
            "maximum visibility",
            "perceived visibility",
            "visible beam",
            "visibility"
          ],
          "weight": 16
        },
        {
          "reason": "single_beam",
          "terms": ["single beam", "single-beam", "pure focus", "no scatter"],
          "weight": 18
        },
        {
          "reason": "focus_control",
          "terms": [
            "adjustable focus",
            "adjustable focal",
            "focusing",
            "focus mechanism"
          ],
          "weight": 12
        },
        {
          "reason": "distance_feature",
          "terms": ["long range", "long-range", "effective range", "at distance"],
          "weight": 14
        }
      ]
    },
    {
      "name": "portable_field_use",
      "triggers": ["carry", "compact", "handheld", "pocket", "portable"],
      "minimum_trigger_matches": 1,
      "preferences": [
        {
          "reason": "compact_body",
          "terms": ["compact", "pocket", "pocket-sized"],
          "weight": 12
        },
        {
          "reason": "rechargeable_power",
          "terms": [
            "rechargeable",
